# Added by the LCLS drive migration kit (not part of the upstream skill).
# env.sh sources this file last. It makes the skill use the kit's own uv and
# Python, and keeps caches and the SLAC token inside the kit's .sandbox/ folder.
_kit_root="$(cd "$SKILL_DIR/../../.." && pwd)"
export PATH="$_kit_root/.sandbox/bin:$PATH"
export UV_CACHE_DIR="$_kit_root/.sandbox/cache/uv"
export UV_PYTHON_INSTALL_DIR="$_kit_root/.sandbox/python"
export UV_PYTHON_PREFERENCE=only-managed
export UV_NO_CONFIG=1
export JIRA_TOKEN_FILE="$_kit_root/.sandbox/config/jira-search/token"
unset _kit_root
